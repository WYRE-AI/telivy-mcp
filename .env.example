# Telivy API key, from Telivy Portal > Account > Integrations.
# Used by stdio and by HTTP only when AUTH_MODE=env.
# The gateway-mode compose service does not load this. Do not add it to that
# service's environment or via env_file.
TELIVY_API_KEY=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# only. A non-loopback MCP_HTTP_HOST (including 0.0.0.0) is refused. A known
# placeholder secret is still refused. Do not use this outside local development.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when MCP_TRANSPORT=http. Defaults to 127.0.0.1.
# A configured CONDUIT_S2S_SECRET is required to honor a non-loopback host.
# The container image sets MCP_HTTP_HOST=0.0.0.0 explicitly.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Credential source for HTTP: env (process environment) or gateway (required
# X-Telivy-Api-Key header; no env fallback). The container image and Compose
# default to gateway. Stdio ignores this and reads TELIVY_API_KEY.
# AUTH_MODE=env

# LOG_LEVEL=info
